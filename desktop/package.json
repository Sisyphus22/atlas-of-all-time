{
  "name": "atlas-of-all-time",
  "productName": "Atlas of All Time",
  "version": "0.2.0",
  "description": "An interactive timeline from the Big Bang to today, with Claude built in.",
  "author": {
    "name": "Valeria",
    "email": "29075642+Sisyphus22@users.noreply.github.com"
  },
  "homepage": "https://sisyphus22.github.io/atlas-of-all-time/",
  "private": true,
  "main": "main.js",
  "scripts": {
    "page": "node scripts/build-page.js",
    "start": "npm run page && electron .",
    "dist": "npm run page && electron-builder --win",
    "dist:mac": "npm run page && electron-builder --mac",
    "dist:linux": "npm run page && electron-builder --linux"
  },
  "build": {
    "appId": "app.atlasofalltime.desktop",
    "productName": "Atlas of All Time",
    "copyright": "Copyright © 2026 Valeria. All rights reserved.",
    "artifactName": "Atlas-of-All-Time-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas of All Time"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "synopsis": "Interactive timeline from the Big Bang to today",
      "maintainer": "Valeria <29075642+Sisyphus22@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
